# .env olarak kopyala: cp .env.example .env
# Sonra nano .env ile doldur.
#
# ⚠️ ÖNEMLİ: SMTP_HOST'u BOŞ BIRAKMA — sadece SMTP_USER/PASSWORD doldurmak
# yetmez, SMTP_HOST boşsa kod "yapılandırılmadı" moduna düşer ve e-posta
# hiç gönderilmez (2 Ağustos 2026'da bu yüzden e-posta doğrulama saatlerce
# çalışmadı — bkz. PROJECT_SUMMARY.md).

# PostgreSQL şifresi — güçlü bir şey yaz
POSTGRES_PASSWORD=BURAYA_GUCLU_BIR_SIFRE

# JWT secret — aşağıdaki komutla üret, çıktıyı yapıştır:
#   openssl rand -hex 32
SECRET_KEY=BURAYA_OPENSSL_CIKTISI

# Webapp domaini (CORS için)
CORS_ORIGINS=https://kernelkompass.de

# Token süresi (dakika) — 43200 = 30 gün
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# E-posta (Brevo SMTP) — EMAIL_SETUP.md'ye bak
# Boş bırakılırsa e-postalar logda görünür, gönderilmez.
# ÜÇÜ DE doldurulmalı — SMTP_HOST dahil (yukarıdaki uyarıya bak).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

FROM_EMAIL=no-reply@kernelkompass.de
FROM_NAME=KernelKompass

# E-posta doğrulama/şifre sıfırlama linkleri buraya işaret eder
APP_BASE_URL=https://kernelkompass.de
